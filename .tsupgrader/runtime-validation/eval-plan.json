{
  "projectType": "server",
  "setup": [
    {
      "command": "pnpm",
      "args": ["install", "--frozen-lockfile"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "typescript-no-emit",
      "kind": "process",
      "command": "pnpm",
      "args": ["exec", "tsc", "--noEmit", "-p", "tsconfig.json"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "nest-build",
      "kind": "process",
      "command": "pnpm",
      "args": ["build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "eslint-product-image-flow",
      "kind": "process",
      "command": "pnpm",
      "args": [
        "exec",
        "eslint",
        "src/main.ts",
        "src/infra/storage/abstract/file-storage.ts",
        "src/infra/storage/supabase/supabase-storage.module.ts",
        "src/infra/storage/supabase/supabase-storage.service.ts",
        "src/infra/products/abstract/product.repository.ts",
        "src/infra/products/entities/product-image.entity.ts",
        "src/infra/products/entities/product.entity.ts",
        "src/infra/products/impl/product.repository.ts",
        "src/infra/products/services/product.service.ts",
        "src/modules/products/application/dto/product.dto.ts",
        "src/modules/products/application/services/product-image-processor.ts",
        "src/modules/products/application/services/product-image-response.service.ts",
        "src/modules/products/application/use-cases/create-product.use-case.ts",
        "src/modules/products/application/use-cases/find-product-by-id.use-case.ts",
        "src/modules/products/application/use-cases/list-products.use-case.ts",
        "src/modules/products/application/use-cases/list-public-products.use-case.ts",
        "src/modules/products/application/use-cases/set-product-active.use-case.ts",
        "src/modules/products/application/use-cases/update-product.use-case.ts",
        "src/modules/products/products.module.ts",
        "src/modules/products/presentation/controllers/products.controller.ts",
        "test/unit/create-product.use-case.spec.ts",
        "test/unit/list-public-products.use-case.spec.ts",
        "test/unit/product-image-processor.spec.ts",
        "test/unit/product-image-response.service.spec.ts",
        "test/unit/supabase-storage.service.spec.ts"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "pnpm",
      "args": ["run", "test", "--runInBand"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    }
  ]
}
