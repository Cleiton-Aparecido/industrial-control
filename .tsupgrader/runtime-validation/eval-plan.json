{
  "projectType": "server",
  "setup": [
    {
      "command": "pnpm",
      "args": ["install", "--frozen-lockfile"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "typescript-no-emit",
      "kind": "process",
      "command": "pnpm",
      "args": ["exec", "tsc", "--noEmit", "-p", "tsconfig.json"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "nest-build",
      "kind": "process",
      "command": "pnpm",
      "args": ["build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "pnpm",
      "args": ["run", "test", "--runInBand"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    }
  ]
}
